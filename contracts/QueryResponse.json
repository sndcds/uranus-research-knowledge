{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "enum": [
            "uranus_overview",
            "admin_overview",
            "semantic_search_repository",
            "embedding_component",
            "embedding_model",
            "qdrant_usage",
            "encoder_communication",
            "planner_component",
            "geocoding",
            "architecture",
            "founding_date",
            "unknown"
          ],
          "title": "Fact",
          "type": "string"
        },
        "quote": {
          "maxLength": 480,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "fact",
        "value",
        "quote"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Chunk": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/Assertion"
          },
          "maxItems": 12,
          "title": "Assertions",
          "type": "array"
        },
        "chunk_text": {
          "maxLength": 480,
          "minLength": 1,
          "title": "Chunk Text",
          "type": "string"
        },
        "commit_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "documentation",
            "source_code",
            "configuration"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "embedding_version": {
          "default": "d18862d9a48706220815554fac3ebb4dfa46fc28:native-transformers5.17.0-retrieval-normalized-f32:sections-480-overlap64-v2",
          "title": "Embedding Version",
          "type": "string"
        },
        "graph_edge_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Graph Edge Ids",
          "type": "array"
        },
        "graph_node_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Graph Node Ids",
          "type": "array"
        },
        "heading_or_symbol": {
          "maxLength": 500,
          "title": "Heading Or Symbol",
          "type": "string"
        },
        "index_owner": {
          "const": "kulturbytes-project-knowledge-v1",
          "default": "kulturbytes-project-knowledge-v1",
          "title": "Index Owner",
          "type": "string"
        },
        "indexed_at": {
          "format": "date-time",
          "title": "Indexed At",
          "type": "string"
        },
        "knowledge_type": {
          "const": "project_knowledge",
          "default": "project_knowledge",
          "title": "Knowledge Type",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "license": {
          "maxLength": 100,
          "title": "License",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "pattern": "^sndcds/[a-z0-9-]+$",
          "title": "Repository",
          "type": "string"
        },
        "schema_version": {
          "const": "project-chunk-v1",
          "default": "project-chunk-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "service": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service"
        },
        "source_url": {
          "maxLength": 1100,
          "title": "Source Url",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "unit": {
          "maxLength": 600,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit_sha",
        "path",
        "document_type",
        "heading_or_symbol",
        "unit",
        "source_url",
        "content_hash",
        "indexed_at",
        "chunk_text",
        "line_start",
        "line_end",
        "license",
        "graph_node_ids"
      ],
      "title": "Chunk",
      "type": "object"
    },
    "Match": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Chunk"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "node": {
          "$ref": "#/$defs/Node"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "node",
        "evidence"
      ],
      "title": "Match",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeType": {
      "enum": [
        "project",
        "repository",
        "component",
        "service",
        "document",
        "source_file",
        "symbol",
        "api_endpoint",
        "feature",
        "model",
        "datastore",
        "deployment_component",
        "event",
        "occurrence",
        "venue",
        "space",
        "organization",
        "category",
        "genre",
        "area"
      ],
      "title": "NodeType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoritative_source": {
      "const": "project_sources",
      "default": "project_sources",
      "title": "Authoritative Source",
      "type": "string"
    },
    "matches": {
      "items": {
        "$ref": "#/$defs/Match"
      },
      "maxItems": 20,
      "title": "Matches",
      "type": "array"
    },
    "query": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    }
  },
  "required": [
    "query",
    "matches"
  ],
  "title": "QueryResponse",
  "type": "object"
}
