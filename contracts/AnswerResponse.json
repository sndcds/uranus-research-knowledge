{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Public provenance projection: never serialize internal assertion quotes.",
      "properties": {
        "chunk_text": {
          "anyOf": [
            {
              "maxLength": 480,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Text"
        },
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "evidence_available": {
          "const": true,
          "default": true,
          "title": "Evidence Available",
          "type": "boolean"
        },
        "evidence_redistribution_allowed": {
          "title": "Evidence Redistribution Allowed",
          "type": "boolean"
        },
        "excerpt_included": {
          "title": "Excerpt Included",
          "type": "boolean"
        },
        "graph_edge_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Graph Edge Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "license": {
          "title": "License",
          "type": "string"
        },
        "license_source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Source Url"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "repository": {
          "title": "Repository",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository",
        "path",
        "commit_sha",
        "source_url",
        "content_hash",
        "line_start",
        "line_end",
        "license",
        "evidence_redistribution_allowed",
        "excerpt_included",
        "graph_edge_ids"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "key": {
          "enum": [
            "uranus_overview",
            "admin_overview",
            "semantic_search_repository",
            "embedding_component",
            "embedding_model",
            "qdrant_usage",
            "encoder_communication",
            "planner_component",
            "geocoding",
            "architecture",
            "founding_date"
          ],
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "evidence_ids"
      ],
      "title": "Fact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authoritative_source": {
      "const": "project_sources",
      "default": "project_sources",
      "title": "Authoritative Source",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "indexed_commits": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Indexed Commits",
      "type": "object"
    },
    "reason": {
      "enum": [
        "supported",
        "no_explicit_evidence",
        "conflicting_evidence"
      ],
      "title": "Reason",
      "type": "string"
    },
    "supported": {
      "title": "Supported",
      "type": "boolean"
    }
  },
  "required": [
    "supported",
    "facts",
    "evidence",
    "indexed_commits",
    "reason"
  ],
  "title": "AnswerResponse",
  "type": "object"
}
